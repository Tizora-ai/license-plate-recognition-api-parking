# Copy to .env on the server or export these before starting.
HOST=0.0.0.0
PORT=8000

# fast | balanced | accurate
# CPU servers: prefer fast. GPU servers: accurate is fine.
ALPR_MODE=accurate

# Force CPU on Linux (recommended for CPU-only EC2)
ALPR_PROVIDERS=cpu

# Optional overrides:
# ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
# ALPR_OCR_MODEL=cct-xs-v2-global-model
# ALPR_DET_CONF=0.4
# ALPR_INTRA_THREADS=4
# ALPR_INTER_THREADS=1

# Demo endpoint rate limits (max requests per day per IP)
DEMO_DAILY_LIMIT=10
# Set to true if running behind Nginx, Cloudflare, or AWS ALB to read real client IP
TRUST_PROXY_HEADERS=false
